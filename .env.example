# Public canonical URL of the deployed site (no trailing slash). Required for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Contact form delivery (optional). When unset, the form explains that messages are unavailable and points to phone/Instagram.
# Uses the Resend HTTP API (https://resend.com) — server-side only, never exposed to the browser.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
